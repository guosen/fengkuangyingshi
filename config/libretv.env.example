# LibreTV 环境变量（Tier1: Vercel / Cloudflare Pages；Tier2: docker-compose 同键名）
# 复制为 .env 后填入真实值，勿提交 .env

# === 必填 ===
PASSWORD=请设置强密码

# === 推荐：指向本仓库 GitHub Pages 上的订阅 JSON ===
# 部署 Pages 后替换 YOUR_USER 与仓库名，例如：
# DEFAULT_SUBSCRIPTIONS=["https://YOUR_USER.github.io/fengkuangyingshi/data/sources.json"]

# === 可选：多实例 / HTTPS 反代 ===
# PROXY_SECRET=openssl rand -hex 32
# COOKIE_SECURE=true

# === 可选：不依赖订阅时，直接预置少量源（与 sources.json 二选一或并存）===
# DEFAULT_SOURCES=[{"name":"示例","url":"https://example.com/api.php/provide/vod","detail":"https://example.com"}]

# === Tier2 VPS：内网 IPTV 时 ===
# LIVE_ALLOW_PRIVATE=1
